<Window x:Class="uipracticewin.Window1"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:uipracticewin"
        mc:Ignorable="d"
        Title="Login" Height="450" Width="800" Foreground="#FFDE1D1D">
    <Window.Background>
        <ImageBrush ImageSource="/macos-big-sur-apple-layers-fluidic-colorful-wwdc-stock-3840x2160-1455.jpg"/>
    </Window.Background>
    <Grid>
        <Grid.OpacityMask>
            <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                <GradientStop Color="Black"/>
                <GradientStop Color="#FFC32626" Offset="1"/>
            </LinearGradientBrush>
        </Grid.OpacityMask>
        <Grid.Background>
            <ImageBrush/>
        </Grid.Background>
        <TextBlock HorizontalAlignment="Left" Margin="322,11,0,0" TextWrapping="Wrap" Text="SIGN IN" VerticalAlignment="Top" Height="48" Width="236" Foreground="#FFFFFEFE" FontSize="36" RenderTransformOrigin="0.5,0.5" FontFamily="Tw Cen MT Condensed Extra Bold">
            <TextBlock.RenderTransform>
                <TransformGroup>
                    <ScaleTransform/>
                    <SkewTransform/>
                    <RotateTransform Angle="-0.115"/>
                    <TranslateTransform/>
                </TransformGroup>
            </TextBlock.RenderTransform>
        </TextBlock>
        <Image HorizontalAlignment="Left" Height="100" Margin="331,58,0,0" VerticalAlignment="Top" Width="100" Source="/icons8-user-default-96.png"/>
        <Rectangle HorizontalAlignment="Left" Height="146" Margin="213,188,0,0" Stroke="Black" VerticalAlignment="Top" Width="359" RadiusX="7" RadiusY="7" StrokeThickness="0">
            <Rectangle.Fill>
                <SolidColorBrush Color="Black" Opacity="0.6"/>
            </Rectangle.Fill>
        </Rectangle>
        <TextBlock
            HorizontalAlignment="Left"
            Margin="231,217,0,0"
            TextWrapping="Wrap"
            Text="Username :"
            VerticalAlignment="Top"
            Foreground="#FFFBFBFB"
            FontWeight="Bold" FontSize="14"/>
        <TextBlock
            HorizontalAlignment="Left"
            Margin="231,261,0,0"
            TextWrapping="Wrap"
            Text="Password :"
            VerticalAlignment="Top"
            Foreground="#FFFBFBFB"
            FontWeight="Bold" FontSize="14"/>
        <TextBox
            x:Name="UsernameTextBox"
            HorizontalAlignment="Left"
            Margin="332,218,0,0"
            TextWrapping="Wrap"
            VerticalAlignment="Top"
            Width="120"
            Background="{x:Null}"
            Foreground="#FFF9F4F4"/>
        <PasswordBox
            x:Name="PasswordBox"
            HorizontalAlignment="Left"
            Margin="331,261,0,0"
            VerticalAlignment="Top"
            Width="120"
            Background="{x:Null}"
            Foreground="#FFF9F4F4"/>
        <Button
            x:Name="LoginButton"
            Content="LOGIN"
            HorizontalAlignment="Left"
            Margin="326,305,0,0"
            VerticalAlignment="Top"
            Width="125"
            Background="#FF7413ED"
            Foreground="#FFFFF9F9"
            FontSize="14"
            FontWeight="Bold"
            Click="LoginButton_Click"/>
        <Button
            x:Name="RegisterButton"
            Content="SIGN UP"
            HorizontalAlignment="Left"
            Margin="470,305,0,0"
            VerticalAlignment="Top"
            Width="125"
            Background="#FF7413ED"
            Foreground="#FFFFF9F9"
            FontSize="14"
            FontWeight="Bold"
            Click="RegisterButton_Click"/>
        <TextBlock
            x:Name="ErrorMessage"
            HorizontalAlignment="Left"
            Margin="231,330,0,0"
            TextWrapping="Wrap"
            Foreground="Red"
            FontSize="12"
            Height="50"
            Width="359"/>
    </Grid>
</Window>