<Window x:Class="uipracticewin.Registration"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:uipracticewin"
        mc:Ignorable="d"
        Title="Registration" Height="450" Width="800">
    <Grid>
		
        <Grid.Background>
            <ImageBrush ImageSource="/macos-big-sur-apple-layers-fluidic-colorful-wwdc-stock-3840x2160-1455.jpg"/>
        </Grid.Background>
        <TextBlock HorizontalAlignment="Left" Margin="355,30,0,0" TextWrapping="Wrap" Text="SIGN UP" VerticalAlignment="Top" Height="38" Width="195" Foreground="White" FontSize="36" FontWeight="Bold" FontFamily="Tw Cen MT Condensed Extra Bold"/>
        <Rectangle HorizontalAlignment="Left" Height="323" Margin="214,90,0,0" Stroke="Black" VerticalAlignment="Top" Width="407">
            <Rectangle.Fill>
                <SolidColorBrush Color="Black" Opacity="0.6"/>
            </Rectangle.Fill>
        </Rectangle>
        <TextBlock HorizontalAlignment="Left" Margin="234,134,0,0" TextWrapping="Wrap" Text="First name" VerticalAlignment="Top" Height="27" Width="84" Foreground="White" FontSize="14" FontWeight="Bold"/>
        <TextBlock HorizontalAlignment="Left" Margin="234,287,0,0" TextWrapping="Wrap" Text="phone no" VerticalAlignment="Top" Height="27" Width="84" Foreground="White" FontSize="14" FontWeight="Bold"/>
        <TextBlock HorizontalAlignment="Left" Margin="234,242,0,0" TextWrapping="Wrap" Text="Username" VerticalAlignment="Top" Height="28" Width="84" Foreground="White" FontSize="14" FontWeight="Bold"/>
        <TextBlock HorizontalAlignment="Left" Margin="234,190,0,0" TextWrapping="Wrap" Text="Last name" VerticalAlignment="Top" Height="27" Width="105" Foreground="White" FontSize="14" FontWeight="Bold"/>
        <TextBlock HorizontalAlignment="Left" Margin="234,332,0,0" TextWrapping="Wrap" Text="Password" VerticalAlignment="Top" Height="27" Width="84" Foreground="White" FontSize="14" FontWeight="Bold"/>
        
        <TextBox x:Name="FirstNameBox" HorizontalAlignment="Left" Margin="392,127,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="120" Background="{x:Null}" Foreground="#FFFBFBFB" FontSize="14"/>
        <TextBox x:Name="LastNameBox" HorizontalAlignment="Left" Margin="400,183,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="120" Background="{x:Null}" Foreground="#FFFBFBFB" FontSize="14"/>
        <TextBox x:Name="UsernameBox" HorizontalAlignment="Left" Margin="400,242,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="120" Background="{x:Null}" Foreground="#FFFBFBFB" FontSize="14"/>
        <TextBox x:Name="PhoneBox" HorizontalAlignment="Left" Margin="400,280,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="120" Background="{x:Null}" Foreground="#FFFBFBFB" FontSize="14"/>
        <PasswordBox x:Name="PasswordBoxReg" HorizontalAlignment="Left" Margin="400,332,0,0" VerticalAlignment="Top" Width="120" Background="{x:Null}" Foreground="#FFFBEFEF" Height="27"/>
        
        <Button x:Name="SignUpButton" Content="Sign Up" HorizontalAlignment="Left" Margin="355,375,0,0" VerticalAlignment="Top" Height="26" Width="137" Background="#FF6712EA" Foreground="White" FontWeight="Bold" FontSize="14" Click="SignUpButton_Click"/>
        <TextBlock x:Name="RegistrationError" HorizontalAlignment="Left" Margin="234,415,0,0" TextWrapping="Wrap" Foreground="Red" FontSize="12" Height="30" Width="350"/>
    </Grid>
</Window>
    
